# Copy this file to .env and fill in the values. Never commit .env.
# Keys are validated at startup (src/config/env.js); a missing key stops the app with a list.

# development | test | production  (default: development)
NODE_ENV=

# Port the server listens on (default: 8080)
PORT=

# MongoDB connection string, e.g. a MongoDB Atlas "mongodb+srv://..." URI.
# (Old name ATLASDB_URL is still accepted with a warning.)
MONGODB_URI=

# Secret used to sign session cookies. In production it must be at least 32
# random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Cloudinary credentials (image uploads).
# (Old names CLOUD_NAME / CLOUD_API_KEY / CLOUD_API_SECRET are still accepted.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox. The server token is used for geocoding and is never sent to browsers.
# The public token (starts with pk.) is sent to browsers: restrict it by URL in
# your Mapbox account. The two must be DIFFERENT tokens (using one token for
# both is an error in production). Old name MAP_TOKEN is still accepted for
# both, with a warning. See docs/ADR/007-maps-provider.md.
MAPBOX_SERVER_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Optional (default false). true = geocode with Mapbox's "permanent" mode, the
# licence for coordinates stored in the database. Needs an account that may use
# it and is billed per request; read ADR-007 before turning it on.
MAPBOX_GEOCODING_PERMANENT=

# Public base URL of the site, e.g. https://dimora.example.com (required in
# production; default in development: http://localhost:<PORT>).
APP_BASE_URL=

# Optional: comma-separated DNS servers, e.g. 8.8.8.8,1.1.1.1. Only set this if
# MongoDB Atlas lookups fail on your network (the app used to force these).
DNS_SERVERS=

# Optional: the housekeeping job (expires booking requests nobody answered in
# 24 h, completes finished stays, removes orphaned availability rows and drafts
# untouched for 90 days). Default: enabled, every 60 seconds (5 to 3600).
# Set SWEEPER_ENABLED=false only to pause it; with several app instances leave
# it on everywhere (it is safe to run in parallel).
SWEEPER_ENABLED=
SWEEPER_INTERVAL_SECONDS=

# Optional: how many days after check-out a guest can still review a stay.
# Default 30 (1 to 365).
REVIEW_WINDOW_DAYS=

# Optional: how many days after posting a guest can still edit their review
# (rating and comment). Default 7 (1 to 90).
REVIEW_EDIT_DAYS=

# Optional: nearby places (restaurants, shops, transit...) from OpenStreetMap's
# Overpass API, fetched when a listing is published and when a host presses
# "Refresh nearby places" (once a day). Guests never trigger a fetch.
# NEARBY_ENABLED: default true (false in tests). NEARBY_CONTACT: an email or URL
# that identifies you to the Overpass operators (sent in the User-Agent); set it
# before going live. OVERPASS_URL: default is the public overpass-api.de server;
# use another instance if you expect heavy use (public servers ask for under
# ~10,000 queries a day).
NEARBY_ENABLED=
NEARBY_CONTACT=
OVERPASS_URL=
