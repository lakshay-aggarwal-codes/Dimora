<% layout("/layouts/boilerPlate") %>
<%# Locals: token. A button, not an automatic action: opening the link must not use it up. %>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h1>Confirm your email address</h1>
            <p>Press the button to confirm that this is your address.</p>
            <form method="post" action="/verify-email">
                <%- include("../includes/csrf.ejs") %>
                <input type="hidden" name="token" value="<%= token %>">
                <button type="submit" class="btn btn-dark">Confirm my email</button>
            </form>
        </div>
    </div>
