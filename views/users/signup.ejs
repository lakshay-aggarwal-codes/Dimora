<% layout("/layouts/boilerPlate") %>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h1>SignUp on Dimora</h1>
            <form method="post" action="/signup" class="needs-validation" novalidate>
                <%- include("../includes/csrf.ejs") %>

                <%- include("../partials/form-field.ejs", {
                    id: "username", label: "Username", autocomplete: "username", required: true,
                    hint: "3 to 30 characters: letters, numbers and underscores.",
                    feedback: "Use 3 to 30 letters, numbers or underscores.",
                    attrs: { minlength: 3, maxlength: 30, pattern: "[A-Za-z0-9_]+" }
                }) %>
                <%- include("../partials/form-field.ejs", {
                    id: "email", label: "Email", type: "email", autocomplete: "email", required: true,
                    feedback: "Enter a valid email address.",
                    attrs: { maxlength: 254 }
                }) %>
                <%- include("../partials/form-field.ejs", {
                    id: "password", label: "Password", type: "password", autocomplete: "new-password", required: true,
                    hint: "At least 10 characters. Avoid common passwords.",
                    feedback: "Use at least 10 characters.",
                    attrs: { minlength: 10, maxlength: 128 }
                }) %>

                <button type="submit" class="btn btn-dark">SignUp</button>
            </form>
        </div>
    </div>
