<% layout("/layouts/boilerPlate") %>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h1>Login on Dimora</h1>
            <form method="post" action="/login" class="needs-validation" novalidate>
                <%- include("../includes/csrf.ejs") %>
                <% if (typeof next !== 'undefined' && next) { %>
                <input type="hidden" name="next" value="<%= next %>">
                <% } %>

                <%- include("../partials/form-field.ejs", {
                    id: "username", label: "Username", autocomplete: "username",
                    required: true, feedback: "Enter your username."
                }) %>
                <%- include("../partials/form-field.ejs", {
                    id: "password", label: "Password", type: "password", autocomplete: "current-password",
                    required: true, feedback: "Enter your password."
                }) %>

                <button type="submit" class="btn btn-dark">Login</button>
            </form>
        </div>
    </div>
