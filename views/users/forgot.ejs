<% layout("/layouts/boilerPlate") %>
    <div class="row mt-3">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <h1>Forgot your password?</h1>
            <p class="text-body-secondary">Enter the email address of your account. If we find it, we send a link to choose a new password.</p>
            <form method="post" action="/forgot-password" class="needs-validation" novalidate>
                <%- include("../includes/csrf.ejs") %>
                <%- include("../partials/form-field.ejs", {
                    id: "email", label: "Email", type: "email", autocomplete: "email", required: true,
                    feedback: "Enter a valid email address.",
                    attrs: { maxlength: 254 }
                }) %>
                <button type="submit" class="btn btn-dark">Send the link</button>
                <a class="btn btn-link" href="/login">Back to login</a>
            </form>
        </div>
    </div>
