<%#
    The review form (P12-T02), shared by the listing page and the booking page.
    Locals: action (POST url), reservationId, idPrefix (ids must be unique on a
    page; default "first"), intro (optional sentence). No star is pre-selected
    and the rating is required; public/js/script.js shows the message under the
    stars when the form is sent without one.
%>
<%
    const prefix = typeof idPrefix !== "undefined" && idPrefix ? idPrefix : "first";
    const stars = [[1, "Terrible"], [2, "Not good"], [3, "Average"], [4, "Very good"], [5, "Amazing"]];
%>
<form method="post" action="<%= action %>" novalidate class="needs-validation detail-review-form">
    <%- include("../includes/csrf.ejs") %>
    <input type="hidden" name="review[reservation]" value="<%= reservationId %>">
    <% if (typeof intro !== "undefined" && intro) { %><p class="small text-body-secondary"><%= intro %></p><% } %>
    <div class="mb-3">
        <p class="form-label" aria-hidden="true">Rating</p>
        <fieldset class="starability-slot" aria-describedby="<%= prefix %>-rating-feedback">
            <legend class="visually-hidden">Rating, from 1 to 5 stars</legend>
            <% stars.forEach(([n, title]) => { %>
            <input type="radio" id="<%= prefix %>-rate<%= n %>" name="review[rating]" value="<%= n %>" required />
            <label for="<%= prefix %>-rate<%= n %>" title="<%= title %>"><%= n %> star<%= n === 1 ? "" : "s" %></label>
            <% }) %>
        </fieldset>
        <div id="<%= prefix %>-rating-feedback" class="text-danger small" role="alert" data-rating-feedback hidden>
            Please choose a rating.
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="<%= prefix %>-comment">Comment</label>
        <textarea class="form-control" id="<%= prefix %>-comment" name="review[comment]" rows="5" maxlength="2000"
            aria-describedby="<%= prefix %>-comment-feedback" required></textarea>
        <div class="invalid-feedback" id="<%= prefix %>-comment-feedback">Please write a comment.</div>
    </div>
    <button type="submit" class="btn btn-outline-dark">Submit review</button>
</form>
