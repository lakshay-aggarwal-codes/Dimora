<%#
    One listing in a grid. Local: item = { id, title, imageUrl, location,
    country, priceMinor, currency, rating, reviewCount, taxNote }.
    Missing image -> a stock photo; missing price -> "Price not set"; no
    rating -> the rating line is left out. A long title is cut to two lines
    by CSS (the whole title stays in the page).
%>
<%
    const FALLBACK_IMAGE = "https://images.unsplash.com/photo-1564013799919-ab600027ffc6";
    const cardImage = item.imageUrl ? item.imageUrl : FALLBACK_IMAGE;
    // Sized pictures (P18-T01): the card shows a 800 px version, and srcset lets a
    // phone take 400 px. The helpers may be missing in a bare test app.
    const cardSrc = typeof imageUrl === "function" ? imageUrl(cardImage, "card") : cardImage;
    const cardSrcset = typeof imageSrcset === "function" ? imageSrcset(cardImage, [400, 800, 1200]) : "";
    const where = [item.location, item.country].filter(Boolean).join(", ");
    const hasRating = typeof item.rating === "number" && Number.isFinite(item.rating);
    // `savedIds` (a Set of ids) comes from the withSavedIds middleware; pages
    // that do not load it show an empty heart.
    const isSaved = typeof savedIds !== "undefined" && savedIds && typeof savedIds.has === "function" && savedIds.has(String(item.id));
%>
<div class="listing-card-wrap">
<a href="/listings/<%= encodeURIComponent(item.id) %>" class="listing-link">
    <div class="card h-100 listing-card">
        <%# The title below names the link, so the photo is decorative: empty alt. %>
        <img src="<%= cardSrc %>"<% if (cardSrcset) { %> srcset="<%= cardSrcset %>" sizes="(min-width: 992px) 33vw, (min-width: 768px) 50vw, 100vw"<% } %> width="800" height="600" loading="lazy" decoding="async" class="card-img-top listing-card-img" alt="">
        <div class="card-body">
            <p class="card-text">
                <b class="listing-card-title"><%= item.title %></b>
                <% if (where) { %><span class="listing-card-where"><%= where %></span><% } %>
                <%- include("./price.ejs", { amountMinor: item.priceMinor, currency: item.currency, unit: "night", note: item.taxNote }) %>
                <% if (hasRating) { %><span class="listing-card-rating"><%- include("./rating.ejs", { rating: item.rating, count: item.reviewCount }) %></span><% } %>
            </p>
        </div>
    </div>
</a>
<%- include("./save-button.ejs", { listingId: String(item.id), title: item.title, saved: isSaved }) %>
</div>
