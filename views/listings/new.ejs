<% layout("/layouts/boilerPlate")%>
    <div class="row mt-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h1 class="h3">Create New Listing</h1>

            <form method="POST" action="/listings?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" placeholder="Enter title" name="listing[title]" class="form-control" type="text"
                        aria-describedby="title-feedback" required>
                    <div class="invalid-feedback" id="title-feedback">Please enter a title.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="listing[description]" class="form-control" rows="4"
                        aria-describedby="description-feedback" required></textarea>
                    <div class="invalid-feedback" id="description-feedback">Please enter a short description.</div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Listing Image</label>
                    <input id="image" name="listing[image][url]" class="form-control" type="file" accept="image/*"
                        aria-describedby="image-feedback" required>
                    <div class="invalid-feedback" id="image-feedback">Please choose an image.</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-12 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" placeholder="Enter price" name="listing[price]" class="form-control"
                            type="number" min="0" inputmode="numeric" aria-describedby="price-feedback" required>
                        <div class="invalid-feedback" id="price-feedback">Please enter a valid price.</div>
                    </div>

                    <div class="mb-3 col-12 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input id="country" placeholder="Enter country" name="listing[country]" class="form-control"
                            type="text" aria-describedby="country-feedback" required>
                        <div class="invalid-feedback" id="country-feedback">Please enter the country name.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input id="location" placeholder="Enter location" name="listing[location]" type="text"
                        class="form-control" aria-describedby="location-feedback" required>
                    <div class="invalid-feedback" id="location-feedback">Please enter the location.</div>
                </div>

                <div class="mb-5">
                    <button class="btn btn-dark add-btn" type="submit">Add</button>
                </div>
            </form>
        </div>
    </div>
