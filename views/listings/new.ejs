<% layout("/layouts/boilerPlate")%>
    <div class="row">
        <div class="col-8 offset-2">
<br><br>
            <h3>Create New Listing</h3>

            <form method="POST" action="/listings">
                <div class="mb-3">

                    <label for="title" class="form-label">Title</label>
                    <input placeholder="Enter title" name="listing[title]" class="form-control" type="text" required>
                </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" required></textarea>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Image</label>
                    <input placeholder="Enter image URL/Link" name="listing[image]" class="form-control" type="text">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="Price" class="form-label">Price</label>
                        <input placeholder="Enter price" name="listing[price]" class="form-control" type="number"
                            required>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input placeholder="Enter country" name="listing[country]" class="form-control" type="text"
                            required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input placeholder="Enter location" name="listing[location]" type="text" class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <button class="btn btn-dark add-btn" type="submit">Add</button>
                </div>
                <br><br>
            </form>

        </div>
    </div>