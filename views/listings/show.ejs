<% layout("/layouts/boilerPlate")%>
    <%
        const hasOwnImage = Boolean(listing.image && listing.image.url);
        const imageUrl = hasOwnImage
            ? listing.image.url
            : "https://images.unsplash.com/photo-1564013799919-ab600027ffc6";
        const ownerName = listing.owner && listing.owner.username;
        const hasPrice = typeof listing.price === "number" && Number.isFinite(listing.price);
        const canEditListing = can("listing:edit", listing);
        const canDeleteListing = can("listing:delete", listing);
        const reviews = Array.isArray(listing.reviews) ? listing.reviews : [];
        const where = [listing.location, listing.country].filter(Boolean).join(", ");
    %>
    <article class="listing-detail mt-3">
        <header class="listing-header">
            <h1><%= listing.title %></h1>
            <% if (where) { %>
                <p class="listing-where"><%= where %></p>
            <% } %>
        </header>

        <%# Phones: one column in reading order (photo, about, price and map, reviews). From lg: two columns. %>
        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <figure class="listing-hero">
                    <img class="card-img-top show-img" src="<%= imageUrl %>" alt="<%= hasOwnImage ? 'Photo of ' + listing.title : '' %>">
                </figure>

                <section aria-labelledby="about-heading">
                    <h2 id="about-heading" class="h4">About this place</h2>
                    <% if (ownerName) { %>
                        <p>Owned by <i><%= ownerName %></i></p>
                    <% } %>
                    <p><%= listing.description %></p>
                </section>
            </div>

            <aside class="col-12 col-lg-5" aria-labelledby="summary-heading">
                <h2 id="summary-heading" class="visually-hidden">Price and location</h2>

                <div class="listing-panel">
                    <% if (hasPrice) { %>
                        <p class="listing-price">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="price-unit">/ night</span></p>
                    <% } else { %>
                        <p class="listing-price">Price not available</p>
                    <% } %>

                    <% if (canEditListing || canDeleteListing) { %>
                        <div class="listing-actions">
                            <% if (canEditListing) { %>
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                            <% } %>
                            <% if (canDeleteListing) { %>
                                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                    <%- include("../includes/csrf.ejs") %>
                                    <button type="submit" class="btn btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <section class="mt-4" aria-labelledby="map-heading">
                    <h2 id="map-heading" class="h4">Where you'll be</h2>
                    <% if (typeof mapPoint !== 'undefined' && mapPoint) { %>
                        <div id="map" data-token="<%= mapPublicToken %>" data-lng="<%= mapPoint.lng %>"
                            data-lat="<%= mapPoint.lat %>" data-title="<%= listing.title %>"></div>
                    <% } else { %>
                        <p class="text-muted">The map is not available for this listing yet.</p>
                    <% } %>
                </section>
            </aside>
        </div>

        <section class="listing-reviews" aria-labelledby="reviews-heading">
            <h2 id="reviews-heading" class="h4">Reviews</h2>

            <% if (currUser) { %>
                <form method="post" action="/listings/<%= listing.id %>/reviews" novalidate class="needs-validation mb-5">
                    <%- include("../includes/csrf.ejs") %>
                    <div class="mb-3 mt-3">
                        <span class="form-label d-block" aria-hidden="true">Rating</span>
                        <fieldset class="starability-slot" aria-describedby="rating-feedback">
                            <legend class="visually-hidden">Rating</legend>
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" required />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" required />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" required />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" required />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                        <div class="form-error" id="rating-feedback" role="alert" data-rating-feedback hidden>
                            Please choose a rating.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="comment">Comment</label>
                        <textarea class="form-control" id="comment" required name="review[comment]" rows="5"
                            aria-describedby="comment-feedback"></textarea>
                        <div class="invalid-feedback" id="comment-feedback">
                            Please write a comment.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline-dark">Submit</button>
                </form>
            <% } %>

            <% if (reviews.length > 0) { %>
                <ul class="list-unstyled row row-cols-1 row-cols-md-2 g-3">
                    <% reviews.forEach((review) => { %>
                        <% const reviewer = review.author ? review.author.username : "Unknown User"; %>
                        <li class="col">
                            <article class="review-card">
                                <h3 class="review-author">@ <%= reviewer %></h3>
                                <p class="review-rating">
                                    <span aria-hidden="true"><%= review.rating %> &#9733;</span>
                                    <span class="visually-hidden">Rated <%= review.rating %> out of 5</span>
                                </p>
                                <p class="mb-0"><%= review.comment %></p>
                                <% if (can("review:delete", review)) { %>
                                    <form method="post"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=Delete">
                                        <%- include("../includes/csrf.ejs") %>
                                        <button type="submit" class="btn btn-sm btn-dark">Delete Review<span class="visually-hidden"> by <%= reviewer %></span></button>
                                    </form>
                                <% } %>
                            </article>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p class="text-muted">No reviews yet.</p>
            <% } %>
        </section>
    </article>

    <script src="/js/map.js"></script>
