<% layout("/layouts/boilerPlate")%>
    <%
        const ownerName = listing.owner && listing.owner.username;
        const nightlyMinor = listing.pricing && listing.pricing.nightlyMinor;
        const hasPrice = Number.isInteger(nightlyMinor);
        const canEditListing = can("listing:edit", listing);
        const canDeleteListing = can("listing:delete", listing);
    %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3>
                <%= listing.title%>
            </h3>
        </div>
        <div class="card col-6 show-card listing-card offset-3">
            <%- include("../partials/gallery.ejs", { images: gallery, title: listing.title }) %>
            <div class="card-body">
                <p class="card-text">
                    <% if (ownerName) { %>
                        <br>Owned by
                        <i>
                            <%= ownerName %>
                        </i>
                        <br><br>
                    <% } %>
                    <%= listing.description%><br><br>
                        <% if (hasPrice) { %>
                            <%= formatMoney(nightlyMinor, listing.pricing.currency || "INR") %>
                        <% } else { %>
                            Price not available
                        <% } %><br><br>
                            <%= listing.location%><br><br>
                                <%= listing.country%>

                </p>
            </div>
        </div>


        <br>
    </div>

    <% if(canEditListing || canDeleteListing){ %>
        <div class="btns">

            <% if(canEditListing){ %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3">Edit </a>
            <% } %>

            <% if(canDeleteListing){ %>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <%- include("../includes/csrf.ejs") %>
                <button type="submit" class="btn btn-dark offset-4">
                    Delete
                </button>
            </form>
            <% } %>
        </div>
        <%}%>

            <div class="col-8 offset-3 mb-3">
                <hr>
                <% if(currUser){ %>
                    <h4>
                        Leave us a review!
                    </h4>
                    <form method="post" action="/listings/<%= listing.id%>/reviews" novalidate class="needs-validation">
                        <%- include("../includes/csrf.ejs") %>
                        <div class="mb-3 mt-3">
                            <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" required />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" required />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" required />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" required />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <div class="text-danger small" data-rating-feedback hidden>
                                Please choose a rating.
                            </div>

                            <!-- <input type="range" min="1" max="5" id="rating" class="form-range" name="review[rating]"> -->
                        </div>
                        <div class="mb-3 mt-3">
                            <label class="form-label" for="comment">Comment</label>
                            <textarea class="form-control" id="comment" required name="review[comment]" cols="30"
                                rows="5"></textarea>
                            <div class="invalid-feedback">
                                Please some comments for review
                            </div>
                        </div>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <%}%>

                        <% if(listing.reviews.length>0) {%>
                            <hr>
                            <div class="row">
                                <p><b>All Reviews</b></p>
                                <% for(review of listing.reviews){%>
                                    <div class="card col-5 ms-3 mb-3">
                                        <div class="card-body">
                                            <h5 class="card-title">@
                                                <%= review.author ? review.author.username : "Unknown User" %>
                                            </h5>
                                            <p class="card-text ">
                                                <%=review.rating%> &#9733;
                                            </p>
                                            <p class="card-text">
                                                <%=review.comment%>
                                            </p>
                                        </div>
                                        <% if (can("review:delete", review)) { %>
                                        <form class="mb-3 text-end" method="post"
                                            action="/listings/<%= listing._id%>/reviews/<%= review._id%>?_method=Delete">
                                            <%- include("../includes/csrf.ejs") %>
                                            <button class="btn btn-sm btn-dark">Delete Review</button>
                                        </form>
                                        <% } %>
                                    </div>
                                    <%}%>
                            </div>
                            <% }%>

            </div>
            <div class="col-6 offset-3 mb-3">
                <h3>Where you'll be</h3>
                <% if (typeof mapPoint !== 'undefined' && mapPoint) { %>
                    <div id="map" data-token="<%= mapPublicToken %>" data-lng="<%= mapPoint.lng %>"
                        data-lat="<%= mapPoint.lat %>" data-title="<%= listing.title %>"></div>
                <% } else { %>
                    <p class="text-muted">The map is not available for this listing yet.</p>
                <% } %>
            </div>

            <script src="/js/map.js"></script>