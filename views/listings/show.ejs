<% layout("/layouts/boilerPlate")%>
    <%
        const nightlyMinor = listing.pricing && listing.pricing.nightlyMinor;
        const hasPrice = Number.isInteger(nightlyMinor);
        // "Preview as a guest" hides everything only the host sees.
        const guestPreview = typeof guestView !== "undefined" && guestView;
        const canEditListing = !guestPreview && can("listing:edit", listing);
        // A report link is offered to everybody except the maker of the thing
        // (a visitor who is not signed in is asked to log in first).
        const signedIn = typeof currUser !== "undefined" && Boolean(currUser);
        const canReport = (owner) => !signedIn || can("report:create", { owner });
        const canDeleteListing = !guestPreview && can("listing:delete", listing);
        const place = [listing.location, listing.country].filter(Boolean).join(", ");
        const reviews = Array.isArray(listing.reviews) ? listing.reviews : [];
        // Ids of the reviews the signed-in guest can still edit (P12-T03).
        const editableIds = typeof editableReviewIds !== "undefined" && Array.isArray(editableReviewIds) ? editableReviewIds : [];
        const summary = typeof ratingSummary !== "undefined" && ratingSummary ? ratingSummary : { average: null, count: 0 };
        const labels = typeof facts !== "undefined" && facts ? facts : {};
        const cap = listing.capacity || {};
        const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
        const isCount = (n) => Number.isFinite(n) && n >= 0;
        const keyFacts = [
            isCount(cap.guests) ? { icon: "fa-user-group", text: plural(cap.guests, "guest") } : null,
            isCount(cap.bedrooms) ? { icon: "fa-door-open", text: cap.bedrooms === 0 ? "Studio" : plural(cap.bedrooms, "bedroom") } : null,
            isCount(cap.beds) ? { icon: "fa-bed", text: plural(cap.beds, "bed") } : null,
            isCount(cap.bathrooms) ? { icon: "fa-bath", text: plural(cap.bathrooms, "bathroom") } : null
        ].filter(Boolean);
        const kind = [labels.roomType, labels.propertyType].filter(Boolean).join(" · ");
        const host = listing.owner || null;
        const hostName = host && (host.displayName || host.username);
        const hostInitial = hostName ? Array.from(hostName)[0].toUpperCase() : "";
        const joined = host && host.createdAt;
        const memberSince = joined && typeof joined.getUTCFullYear === "function" && !Number.isNaN(joined.getTime()) ? joined.getUTCFullYear() : null;
        const amenitySections = typeof amenityGroups !== "undefined" && Array.isArray(amenityGroups) ? amenityGroups : [];
        const rulesText = typeof listing.houseRules === "string" ? listing.houseRules.trim() : "";
        const knowRows = [
            listing.checkInTime ? ["Check-in", `from ${listing.checkInTime}`] : null,
            listing.checkOutTime ? ["Check-out", `by ${listing.checkOutTime}`] : null,
            Number.isInteger(listing.minNights) && Number.isInteger(listing.maxNights) ? ["Length of stay", listing.minNights === listing.maxNights ? plural(listing.minNights, "night") : `${listing.minNights} to ${plural(listing.maxNights, "night")}`] : null,
            labels.cancellation ? ["Cancellation", labels.cancellation] : null,
            typeof listing.instantBook === "boolean" ? ["Booking", listing.instantBook ? "Instant book" : "The host approves each request"] : null
        ].filter(Boolean);
    %>
    <article class="listing-detail mt-3">
        <% if (guestPreview) { %>
        <div class="alert alert-info" role="status">
            This is how guests see your listing.
            <a href="/host/listings/<%= listing._id %>/status">Back to your listing's status</a>
        </div>
        <% } else if (listing.status !== "published" && canEditListing) { %>
        <div class="alert alert-warning" role="status">
            This listing is <strong><%= listing.status === "draft" ? "a draft" : (listing.status === "suspended" ? "suspended" : "unpublished") %></strong>: only you<%= listing.status === "suspended" ? " and the moderators" : "" %> can see it.
            <a href="/host/listings/<%= listing._id %>/status">See what is left to do</a>
        </div>
        <% } %>
        <div class="mb-3">
            <div class="detail-title-row">
                <h1><%= listing.title %></h1>
                <%- include("../partials/save-button.ejs", { listingId: String(listing._id), title: listing.title, saved: typeof savedIds !== "undefined" && savedIds && typeof savedIds.has === "function" && savedIds.has(String(listing._id)) }) %>
            </div>
            <% if (place) { %><p class="detail-place"><%= place %></p><% } %>
            <% if (kind || summary.count > 0) { %>
            <p class="detail-meta">
                <% if (kind) { %><span><%= kind %></span><% } %>
                <% if (summary.count > 0) { %><a class="detail-rating" href="#reviews-heading"><%- include("../partials/rating.ejs", { rating: summary.average, count: summary.count }) %></a><% } %>
            </p>
            <% } %>
            <% if (!guestPreview && canReport(listing.owner)) { %>
            <p class="small mt-1 mb-0"><a href="/reports/new?kind=listing&id=<%= listing._id %>" data-report-link>Report this listing</a></p>
            <% } %>
        </div>

        <div class="row g-4">
            <!-- Photos and description (the first column on large screens) -->
            <div class="col-12 col-lg-7">
                <%- include("../partials/gallery.ejs", { images: gallery, title: listing.title }) %>

                <% if (keyFacts.length > 0) { %>
                <ul class="key-facts" aria-label="Key facts">
                    <% keyFacts.forEach((fact) => { %>
                    <li><i class="fa-solid <%= fact.icon %>" aria-hidden="true"></i> <%= fact.text %></li>
                    <% }) %>
                </ul>
                <% } %>

                <section aria-labelledby="about-heading" class="mt-4">
                    <h2 id="about-heading" class="h4">About this place</h2>
                    <p class="detail-description"><%= listing.description %></p>
                </section>

                <% if (hostName) { %>
                <section aria-labelledby="host-heading" class="host-card mt-4">
                    <span class="host-avatar" aria-hidden="true"><%= hostInitial %></span>
                    <div>
                        <h2 id="host-heading" class="h5 mb-0">Hosted by <%= hostName %></h2>
                        <% if (typeof hostTrust !== "undefined" && hostTrust && hostTrust.items.length) { %>
                        <%- include("../partials/trust.ejs", { trust: hostTrust }) %>
                        <% } else if (memberSince) { %><p class="mb-0 text-body-secondary">Member since <%= memberSince %></p><% } %>
                    </div>
                    <% if (!guestPreview && typeof currUser !== "undefined" && currUser && typeof can === "function" && can("conversation:start", listing)) { %>
                    <form action="/listings/<%= listing._id %>/contact" method="POST" class="ms-auto">
                        <%- include("../includes/csrf.ejs") %>
                        <button type="submit" class="btn btn-sm btn-outline-dark">Contact host</button>
                    </form>
                    <% } %>
                </section>
                <% } %>

                <% if (amenitySections.length > 0) { %>
                <section aria-labelledby="amenities-heading" class="mt-4">
                    <h2 id="amenities-heading" class="h4">What this place offers</h2>
                    <% amenitySections.forEach((section) => { %>
                    <h3 class="h6 amenity-group-title"><%= section.group %></h3>
                    <ul class="amenity-list">
                        <% section.items.forEach((label) => { %><li><%= label %></li><% }) %>
                    </ul>
                    <% }) %>
                </section>
                <% } %>

                <% const accessInfo = typeof accessibility !== "undefined" && accessibility && Array.isArray(accessibility.labels) ? accessibility : null; %>
                <% if (accessInfo && accessInfo.labels.length > 0) { %>
                <section aria-labelledby="accessibility-heading" class="mt-4" data-accessibility>
                    <h2 id="accessibility-heading" class="h4">Accessibility</h2>
                    <p class="text-body-secondary mb-2"><%= accessInfo.notice %></p>
                    <ul class="amenity-list">
                        <% accessInfo.labels.forEach((label) => { %><li><%= label %></li><% }) %>
                    </ul>
                    <% if (!guestPreview && canReport(listing.owner)) { %>
                    <p class="small mb-0"><a href="/reports/new?kind=listing&amp;id=<%= listing._id %>&amp;reason=inaccurate" data-report-link>Report inaccurate accessibility information</a></p>
                    <% } %>
                </section>
                <% } %>

                <% if (knowRows.length > 0 || rulesText || listing.noSpecialRules === true) { %>
                <section aria-labelledby="rules-heading" class="mt-4">
                    <h2 id="rules-heading" class="h4">Things to know</h2>
                    <% if (knowRows.length > 0) { %>
                    <dl class="know-list">
                        <% knowRows.forEach(([term, value]) => { %>
                        <dt><%= term %></dt><dd><%= value %></dd>
                        <% }) %>
                    </dl>
                    <% } %>
                    <% if (rulesText) { %>
                    <h3 class="h6">House rules</h3>
                    <p class="detail-description"><%= rulesText %></p>
                    <% } else if (listing.noSpecialRules === true) { %>
                    <p class="text-body-secondary">The host has no special house rules.</p>
                    <% } %>
                </section>
                <% } %>
            </div>

            <!-- Price, actions and map -->
            <div class="col-12 col-lg-5">
                <aside class="detail-panel" aria-labelledby="summary-heading">
                    <h2 id="summary-heading" class="h4">Price</h2>
                    <p class="detail-price">
                        <% if (hasPrice) { %>
                            <span class="price-amount"><%= formatMoney(nightlyMinor, listing.pricing.currency || "INR") %></span>
                            <span class="price-unit">/ night</span>
                        <% } else { %>
                            Price not available
                        <% } %>
                    </p>

                    <div class="booking-slot" id="booking-slot" data-booking-slot>
                        <% if (typeof datePicker !== "undefined" && datePicker) { %>
                            <%- include("../partials/date-picker.ejs", { datePicker }) %>
                            <%- include("../partials/booking-panel.ejs", { datePicker }) %>
                        <% } else { %>
                            <p class="mb-0 text-body-secondary">Online booking is not open yet.</p>
                        <% } %>
                    </div>

                    <% if (canEditListing || canDeleteListing) { %>
                    <div class="detail-actions">
                        <% if (canEditListing) { %>
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                        <a href="/host/listings/<%= listing._id %>/status" class="btn btn-outline-dark">Listing status</a>
                        <% } %>
                        <% if (canDeleteListing) { %>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <%- include("../includes/csrf.ejs") %>
                            <button type="submit" class="btn btn-outline-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                    <% } %>
                </aside>

                <section aria-labelledby="map-heading" class="mt-4">
                    <h2 id="map-heading" class="h4">Where you'll be</h2>
                    <% if (place) { %><p><%= place %></p><% } %>
                    <% if (typeof mapPoint !== 'undefined' && mapPoint) { %>
                        <p id="map-description" class="visually-hidden">The map shows a circle around the approximate area of this stay. It does not mark the exact address.</p>
                        <div id="map" role="region" aria-label="Map of the approximate area" aria-describedby="map-description"
                            data-token="<%= mapPublicToken %>" data-lng="<%= mapPoint.lng %>"
                            data-lat="<%= mapPoint.lat %>" data-radius="<%= typeof mapRadius !== 'undefined' ? mapRadius : 1000 %>" data-title="<%= listing.title %>">
                            <p class="map-fallback">Approximate area<%= place ? ": " + place : "" %>.</p>
                        </div>
                        <p class="text-body-secondary small mt-2">Exact location shared after booking.</p>
                    <% } else { %>
                        <p class="text-body-secondary">The map is not available for this listing yet.</p>
                    <% } %>
                </section>

                <% if (typeof neighborhood !== 'undefined' && neighborhood) { %>
                <%- include("../partials/neighborhood.ejs", { neighborhood }) %>
                <% } %>
            </div>

            <aside class="col-12 col-lg-5" aria-labelledby="summary-heading">
                <h2 id="summary-heading" class="visually-hidden">Price and location</h2>

                <div class="listing-panel">
                    <% if (hasPrice) { %>
                        <p class="listing-price">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="price-unit">/ night</span></p>
                    <% } else { %>
                        <p class="listing-price">Price not available</p>
                    <% } %>

                    <% if (canEditListing || canDeleteListing) { %>
                        <div class="listing-actions">
                            <% if (canEditListing) { %>
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
                            <% } %>
                            <% if (canDeleteListing) { %>
                                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                    <%- include("../includes/csrf.ejs") %>
                                    <button type="submit" class="btn btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <section class="mt-4" aria-labelledby="map-heading">
                    <h2 id="map-heading" class="h4">Where you'll be</h2>
                    <% if (typeof mapPoint !== 'undefined' && mapPoint) { %>
                        <div id="map" data-token="<%= mapPublicToken %>" data-lng="<%= mapPoint.lng %>"
                            data-lat="<%= mapPoint.lat %>" data-title="<%= listing.title %>"></div>
                    <% } else { %>
                        <p class="text-muted">The map is not available for this listing yet.</p>
                    <% } %>
                </section>
            </aside>
        </div>
        <%}%>

        <!-- Reviews: full width below -->
        <section aria-labelledby="reviews-heading" class="mt-5">
            <h2 id="reviews-heading" class="h4">Reviews</h2>
            <% if (summary.count > 0) { %>
            <p class="review-summary"><%- include("../partials/rating.ejs", { rating: summary.average, count: summary.count }) %></p>
            <% } %>

            <%# A review is offered only to a guest with a completed, unreviewed stay inside the review window (P12-T01); `reviewable` comes from the controller and the POST checks it again. %>
            <% if (!guestPreview && typeof reviewable !== "undefined" && reviewable) { %>
            <%- include("../partials/review-form.ejs", {
                action: "/listings/" + listing.id + "/reviews",
                reservationId: reviewable.reservationId,
                idPrefix: "first",
                intro: reviewable.reviewUntil ? "How was your stay? You can review it until " + new Date(reviewable.reviewUntil).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Kolkata" }) + "." : ""
            }) %>
            <% } %>

            <% if (reviews.length > 0) { %>
            <div class="row row-cols-1 row-cols-md-2 g-3 mt-2">
                <% for (const review of reviews) { %>
                <% const reviewer = review.author ? review.author.username : "Unknown User"; %>
                <div class="col">
                    <article class="review-card" id="review-<%= review._id %>">
                        <h3 class="h6">@ <%= reviewer %></h3>
                        <% if (review.createdAt && typeof review.createdAt.getTime === "function" && !Number.isNaN(review.createdAt.getTime())) { %><p class="review-date small text-body-secondary mb-1"><time datetime="<%= review.createdAt.toISOString() %>"><%= new Intl.DateTimeFormat("en-IN", { month: "short", year: "numeric", timeZone: "UTC" }).format(review.createdAt) %></time></p><% } %>
                        <p class="review-rating">
                            <span aria-hidden="true"><%= review.rating %> &#9733;</span>
                            <span class="visually-hidden">Rated <%= review.rating %> out of 5</span>
                        </p>
                        <p class="review-comment"><%= review.comment %></p>
                        <% if (review.editedAt) { %><p class="small text-body-secondary mb-2">Edited</p><% } %>
                        <% const hostReply = review.reply && review.reply.text ? review.reply : null; %>
                        <% if (hostReply) { %>
                        <div class="review-reply border-start ps-3 my-2">
                            <p class="small fw-semibold mb-1">Response from the host</p>
                            <p class="mb-0"><%= hostReply.text %></p>
                        </div>
                        <% } %>
                        <% if (editableIds.includes(String(review._id))) { %>
                        <details class="my-2">
                            <summary class="small">Edit your review<span class="visually-hidden"> by <%= reviewer %></span></summary>
                            <%- include("../partials/review-edit-form.ejs", { action: "/listings/" + listing._id + "/reviews/" + review._id, rating: review.rating, comment: review.comment || "", idPrefix: "edit-" + review._id, from: "listing" }) %>
                        </details>
                        <% } %>
                        <% if (!guestPreview && canEditListing) { %>
                        <details class="my-2">
                            <summary class="small"><%= hostReply ? "Edit your reply" : "Reply to this review" %><span class="visually-hidden"> from <%= reviewer %></span></summary>
                            <%- include("../partials/review-reply-form.ejs", { action: "/listings/" + listing._id + "/reviews/" + review._id, text: hostReply ? hostReply.text : "", idPrefix: "reply-" + review._id }) %>
                            <% if (hostReply) { %>
                            <form method="post" class="mt-2" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply?_method=DELETE">
                                <%- include("../includes/csrf.ejs") %>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Remove reply<span class="visually-hidden"> to <%= reviewer %></span></button>
                            </form>
                            <% } %>
                        </details>
                        <% } %>
                        <% if (canReport(review.author)) { %>
                        <p class="small mb-1"><a href="/reports/new?kind=review&id=<%= review._id %>" data-report-link>Report this review<span class="visually-hidden"> by <%= reviewer %></span></a></p>
                        <% } %>
                        <% if (can("review:delete", review)) { %>
                        <form class="text-end" method="post"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=Delete">
                            <%- include("../includes/csrf.ejs") %>
                            <button type="submit" class="btn btn-sm btn-dark">Delete Review<span class="visually-hidden"> by <%= reviewer %></span></button>
                        </form>
                        <% } %>
                    </article>
                </div>
                <% } %>
            </div>
            <% } else { %>
            <p class="text-body-secondary mt-2">No reviews yet.</p>
            <% } %>
        </section>
    </article>

    <script src="/js/map.js"></script>
    <script src="/js/neighborhood.js"></script>
    <% if (typeof datePicker !== "undefined" && datePicker) { %>
    <script src="/js/date-picker.js"></script>
    <script src="/js/booking-panel.js"></script>
    <% } %>

    <% if (typeof structuredData !== "undefined" && structuredData) { %>
    <script type="application/ld+json"><%- structuredData %></script>
    <% } %>
