<% layout("layouts/boilerPlate") %>
    <%
        // Defaults let this view be rendered with only `allListings` (older tests).
        const f = typeof form !== "undefined" ? form : {};
        const errs = typeof errors !== "undefined" ? errors : {};
        const filterState = typeof pageState !== "undefined" ? pageState : {};
        const resultCount = typeof total === "number" ? total : allListings.length;
        const currentPage = typeof page === "number" ? page : 1;
        const pageCount = typeof totalPages === "number" ? totalPages : 1;
        const isFiltered = typeof filtered !== "undefined" ? filtered : false;
        const todayText = typeof today === "string" && today ? today : undefined;
        const hidden = typeof hiddenFields === "function" ? hiddenFields : () => [];
    %>
    <%
        // The strip, the chips and the filter panel come from the controller
        // (P05-T04); categories are rules over real listing fields, see
        // src/config/categories.js.
        const categoryItems = typeof categories !== "undefined" ? categories : [];
        const chipList = typeof chips !== "undefined" ? chips : [];
        const activeFilterCount = typeof filterCount === "number" ? filterCount : 0;
        const resetHref = typeof resetFiltersHref === "string" ? resetFiltersHref : "/listings";
        const hasCategory = typeof activeCategory !== "undefined" && Boolean(activeCategory);
    %>

    <h1 class="visually-hidden"><%= isFiltered ? "Search results" : "Explore places to stay" %></h1>

    <%# The search form: what the visitor typed comes back even when it was wrong. %>
    <% const errorList = Object.entries(errs); %>
    <form method="GET" action="/listings" class="search-panel" role="search" aria-label="Search stays" novalidate>
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <%- include("../partials/form-field.ejs", { id: "dest", name: "dest", label: "Where to?", type: "search", value: f.dest, error: errs.dest, placeholder: "City, state or country", attrs: { maxlength: 100 } }) %>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <%- include("../partials/form-field.ejs", { id: "in", name: "in", label: "Check-in", type: "date", value: f.in, error: errs.in, attrs: { min: todayText } }) %>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <%- include("../partials/form-field.ejs", { id: "out", name: "out", label: "Check-out", type: "date", value: f.out, error: errs.out, attrs: { min: todayText } }) %>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <%- include("../partials/form-field.ejs", { id: "guests", name: "guests", label: "Guests", type: "number", value: f.guests, error: errs.guests, attrs: { min: 1, max: 16, step: 1, inputmode: "numeric" } }) %>
            </div>
            <div class="col-12 col-sm-6 col-md-2 search-panel-submit">
                <button type="submit" class="btn btn-dark w-100">Search</button>
            </div>
        </div>
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="flex" value="3" id="flex"<% if (filterState.flex === 3) { %> checked<% } %> aria-describedby="flex-help">
            <label class="form-check-label" for="flex">Available ±3 days</label>
            <span class="form-text d-block" id="flex-help">Needs both dates. Also shows stays of the same length that start up to 3 days earlier or later.</span>
        </div>
        <% hidden(filterState, ["dest", "in", "out", "guests", "flex"]).forEach(([name, value]) => { %>
        <input type="hidden" name="<%= name %>" value="<%= value %>">
        <% }) %>
    </form>

    <% if (errorList.length > 0) { %>
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">Some of your search was not used:</p>
        <ul class="mb-0">
            <% errorList.forEach(([name, message]) => { %><li><%= message %></li><% }) %>
        </ul>
    </div>
    <% } %>

    <!-- Category links and tax toggle -->
    <div id="filters">

        <nav class="filter-nav" aria-label="Categories">

            <button type="button" class="filter-arrow" id="filters-prev" aria-label="Previous categories" disabled>
                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
            </button>

            <ul class="filter-container" id="filter-container" role="list">
                <% for (const category of categoryItems) { %>
                <li>
                    <a class="filter<%= category.active ? ' is-active' : '' %>" href="<%= category.href %>"<% if (category.active) { %> aria-current="true"<% } %>>
                        <i class="fa-solid <%= category.icon %>" aria-hidden="true"></i>
                        <span><%= category.label %></span>
                    </a>
                </li>
                <% } %>
            </ul>

            <button type="button" class="filter-arrow" id="filters-next" aria-label="Next categories">
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </button>

        </nav>

        <!-- The tax toggle sits outside the category nav -->
        <div class="tax-toggle">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchMdLabel">
                <label class="form-check-label" for="switchMdLabel">Display Total after Taxes</label>
            </div>
        </div>

    </div>

    <% if (typeof panel !== "undefined") { %>
    <%- include("../partials/filter-panel.ejs", { panel, errors: errs, filterState, filterCount: activeFilterCount, resetHref, hiddenFields: hidden }) %>
    <% } %>

    <% if (chipList.length > 0) { %>
    <nav class="filter-chips" aria-label="Active filters">
        <ul class="filter-chip-list" role="list">
            <% chipList.forEach((chip) => { %>
            <li>
                <a class="filter-chip" href="<%= chip.href %>">
                    <span class="visually-hidden">Remove filter: </span>
                    <span><%= chip.label %></span>
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </a>
            </li>
            <% }) %>
        </ul>
    </nav>
    <% } %>

    <p class="search-status" id="search-status" role="status" hidden></p>

    <%# List / map toggle (P06-T04): hidden until searchMap.js confirms Mapbox GL is available. %>
    <div class="search-view-bar">
        <button type="button" class="btn btn-outline-dark" id="map-toggle" aria-controls="search-map-panel" aria-pressed="false" hidden>Show map</button>
    </div>

    <div class="search-split" id="search-split" data-view="list">
    <div id="results" class="results-region">
    <%
        const destText = filterState.dest ? " for &ldquo;" + String(filterState.dest).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;") + "&rdquo;" : "";
        const stayWord = resultCount === 1 ? "stay" : "stays";
        const range = typeof showing !== "undefined" ? showing : null;
        const isOut = typeof outOfRange !== "undefined" && outOfRange;
        const sortItems = typeof sortLinks !== "undefined" ? sortLinks : [];
        const sugg = typeof suggestions !== "undefined" ? suggestions : null;
    %>
    <p class="results-count" role="status">
        <% if (resultCount === 0) { %>No stays found<% } else if (range) { %>Showing <%- range.from %>&ndash;<%- range.to %> of <%= resultCount %> stays<%- destText %><% } else { %><%= resultCount %> <%= stayWord %><%- destText %><% } %>
        <% if (isFiltered) { %><a class="results-clear" href="/listings">Clear search</a><% } %>
    </p>

    <% if (isFiltered && typeof currUser !== "undefined" && currUser) { %>
    <details class="save-search mb-2" data-save-search>
        <summary class="btn btn-outline-dark btn-sm">Save this search</summary>
        <form action="/saved-searches" method="POST" class="d-flex flex-wrap gap-2 mt-2">
            <%- include("../includes/csrf.ejs") %>
            <% hidden(filterState, []).forEach(([name, value]) => { %><input type="hidden" name="<%= name %>" value="<%= value %>">
            <% }) %>
            <label class="visually-hidden" for="save-search-name">Name for this search</label>
            <input class="form-control form-control-sm w-auto" id="save-search-name" name="name" maxlength="60" required placeholder="e.g. Goa in December">
            <button type="submit" class="btn btn-dark btn-sm">Save</button>
        </form>
    </details>
    <% } %>

    <% if (resultCount > 0 && !isOut && sortItems.length > 0) { %>
    <nav class="sort-bar" aria-label="Sort results">
        <span class="sort-label">Sort by</span>
        <% sortItems.forEach((option) => { %>
        <a class="sort-link<%= option.current ? ' is-current' : '' %>" href="<%= option.href %>"<% if (option.current) { %> aria-current="true"<% } %>><%= option.label %></a>
        <% }) %>
    </nav>
    <% } %>

    <% if (isOut) { %>
    <%- include("../partials/empty-state.ejs", {
        title: "That page does not exist",
        message: pageCount === 1 ? "There is only 1 page of results." : "There are only " + pageCount + " pages of results.",
        icon: "fa-house",
        actionHref: typeof lastPageHref === "string" ? lastPageHref : "/listings",
        actionLabel: "Go to the last page"
    }) %>
    <% } else if (resultCount === 0) { %>
    <%- include("../partials/empty-state.ejs", {
        title: isFiltered ? "No stays match your search" : "No stays yet",
        message: isFiltered ? "Try other dates, a different place or fewer filters." : "Check back soon, new places are added all the time.",
        icon: "fa-house",
        actionHref: isFiltered ? (sugg ? (sugg.hasAnyStays ? "/listings" : "/host/listings/new") : "/listings") : "/host/listings/new",
        actionLabel: isFiltered ? (sugg ? (sugg.hasAnyStays ? "Clear all filters" : "List your place") : "Clear search") : "List your place"
    }) %>
    <% if (sugg && sugg.filterSuggestions.length > 0) { %>
    <section class="suggestions" aria-labelledby="suggest-filters">
        <h2 class="suggestions-title" id="suggest-filters">Try this instead</h2>
        <ul class="suggestions-list" role="list">
            <% sugg.filterSuggestions.forEach((item) => { %>
            <li><a href="<%= item.url %>"><%= item.label %></a> <span class="suggestion-count"><%= item.count %> <%= item.count === 1 ? "stay" : "stays" %></span></li>
            <% }) %>
        </ul>
    </section>
    <% } %>
    <% if (sugg && sugg.destinations.length > 0) { %>
    <section class="suggestions" aria-labelledby="suggest-places">
        <h2 class="suggestions-title" id="suggest-places">Popular destinations</h2>
        <ul class="suggestions-list" role="list">
            <% sugg.destinations.forEach((item) => { %>
            <li><a href="<%= item.url %>"><%= item.label %></a> <span class="suggestion-count"><%= item.count %> <%= item.count === 1 ? "stay" : "stays" %></span></li>
            <% }) %>
        </ul>
    </section>
    <% } %>
    <% if (activeFilterCount > 0 || hasCategory) { %>
    <p class="text-center"><a href="<%= resetHref %>">Remove the filters and category, keep my search</a></p>
    <% } %>
    <% } %>

    <!-- All listing cards: one column on phones, two from md, three from lg -->
    <% if (resultCount > 0 && !isOut) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
        <% for (const list of allListings) { %>
        <div class="col" data-listing-id="<%= list._id %>">
            <%- include("../partials/listing-card.ejs", { item: {
                id: list._id,
                title: list.title,
                imageUrl: list.image && list.image.url,
                location: list.location,
                country: list.country,
                priceMinor: Number.isInteger(list.pricing && list.pricing.nightlyMinor) ? list.pricing.nightlyMinor : null,
                currency: (list.pricing && list.pricing.currency) || "INR",
                taxNote: "+18% GST"
            } }) %>
        </div>
        <% } %>
    </div>
    <% } %>

    <%- include("../partials/pagination.ejs", { page: currentPage, totalPages: pageCount, baseUrl: "/listings", query: filterState }) %>
    </div>

    <section class="search-map-panel" id="search-map-panel" aria-labelledby="search-map-heading" hidden>
        <h2 id="search-map-heading" class="visually-hidden">Map of these stays</h2>
        <p class="search-map-help text-body-secondary">Circles and prices show the approximate area of each stay, not its address. The list shows the same stays.</p>
        <div class="search-map-tools">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="map-follow">
                <label class="form-check-label" for="map-follow">Search as I move the map</label>
            </div>
            <button type="button" class="btn btn-sm btn-dark" id="map-search-area" hidden>Search this area</button>
        </div>
        <p class="search-map-status" id="map-status" role="status" aria-live="polite"></p>
        <div id="search-map" role="region" aria-label="Map of the stays in these results"
            data-token="<%= typeof mapPublicToken !== 'undefined' ? mapPublicToken : '' %>"
            data-endpoint="/api/search/map"
            data-query="<%= typeof mapQuery !== 'undefined' ? mapQuery : '' %>"></div>
    </section>
    </div>

    <script src="/js/filters.js"></script>
    <script src="/js/searchMap.js"></script>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
        // Previous and next category navigation
        const filterContainer = document.getElementById("filter-container");
        const prevButton = document.getElementById("filters-prev");
        const nextButton = document.getElementById("filters-next");

        if (filterContainer && prevButton && nextButton) {
            const scrollAmount = 300;

            prevButton.addEventListener("click", () => {
                filterContainer.scrollBy({
                    left: -scrollAmount,
                    behavior: "smooth"
                });
            });

            nextButton.addEventListener("click", () => {
                filterContainer.scrollBy({
                    left: scrollAmount,
                    behavior: "smooth"
                });
            });

            function updateFilterButtons() {
                const maxScroll = Math.max(
                    0,
                    filterContainer.scrollWidth - filterContainer.clientWidth
                );

                prevButton.disabled = filterContainer.scrollLeft <= 1;
                nextButton.disabled =
                    filterContainer.scrollLeft >= maxScroll - 1;
            }

            filterContainer.addEventListener("scroll", updateFilterButtons);
            window.addEventListener("resize", updateFilterButtons);

            updateFilterButtons();
        }

        // Display tax information based on the toggle state
        const taxSwitch = document.getElementById("switchMdLabel");
        const taxInfo = document.querySelectorAll(".tax-info");

        if (taxSwitch) {
            function updateTaxInfo() {
                taxInfo.forEach((info) => {
                    info.style.display = taxSwitch.checked ? "inline" : "none";
                });
            }

            taxSwitch.addEventListener("change", updateTaxInfo);
            updateTaxInfo();
        }
    </script>