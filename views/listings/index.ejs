<% layout("/layouts/boilerPlate")%>

    <body>
        <h3>All Listings</h3>
        <form method="get" action="/listings/new">
            <button>Create new Listing</button>
        </form>
        <ul>
            <% for(let list of allListings){ %>
                <li>
                    <a href="/listings/<%=list._id%>">
                        <%= list.title%>
                    </a>
                </li>

                <%}%>
        </ul>
    </body>