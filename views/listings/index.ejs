<% layout("layouts/boilerPlate") %>
<%
    // Category strip. These are real links so keyboard and screen-reader users can
    // reach them; the filtering itself arrives with P05-T04 (until then the
    // page ignores ?category and shows every listing).
    const categories = [
        { slug: "trending", label: "Trending", icon: "fa-fire" },
        { slug: "farms", label: "Farms", icon: "fa-tractor" },
        { slug: "mountains", label: "Mountains", icon: "fa-mountain-sun" },
        { slug: "beaches", label: "Beaches", icon: "fa-umbrella-beach" },
        { slug: "amazing-pools", label: "Amazing Pools", icon: "fa-person-swimming" },
        { slug: "desert", label: "Desert", icon: "fa-sun" },
        { slug: "castles", label: "Castles", icon: "fa-chess-rook" },
        { slug: "tiny-homes", label: "Tiny Homes", icon: "fa-house-chimney" },
        { slug: "historical-homes", label: "Historical Homes", icon: "fa-landmark" },
        { slug: "skiing", label: "Skiing", icon: "fa-person-skiing" },
        { slug: "design", label: "Design", icon: "fa-palette" },
        { slug: "lakefront", label: "Lakefront", icon: "fa-water" },
        { slug: "rooms", label: "Rooms", icon: "fa-bed" },
        { slug: "iconic-cities", label: "Iconic Cities", icon: "fa-city" },
        { slug: "camping", label: "Camping", icon: "fa-campground" },
        { slug: "arctic", label: "Arctic", icon: "fa-snowflake" },
        { slug: "countryside", label: "Countryside", icon: "fa-tree" }
    ];
%>
        <h1 class="visually-hidden">Explore places to stay</h1>

        <!-- Category filters and tax toggle -->
        <div id="filters">

            <nav class="filter-nav" aria-label="Categories">

                <button type="button" class="filter-arrow" id="filters-prev" aria-label="Previous categories" disabled>
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>

                <ul class="filter-container" id="filter-container" role="list">
                    <% categories.forEach((category) => { %>
                        <li>
                            <a class="filter" href="/listings?category=<%= category.slug %>">
                                <i class="fa-solid <%= category.icon %>" aria-hidden="true"></i>
                                <span class="filter-label"><%= category.label %></span>
                            </a>
                        </li>
                    <% }) %>
                </ul>

                <button type="button" class="filter-arrow" id="filters-next" aria-label="Next categories">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>

            </nav>

            <!-- Tax toggle is OUTSIDE filter-nav -->
            <div class="tax-toggle">
                <div class="form-check form-switch">

                    <input class="form-check-input" type="checkbox" role="switch" id="switchMdLabel">

                    <label class="form-check-label" for="switchMdLabel">
                        Display Total after Taxes
                    </label>

                </div>
            </div>

        </div>
        <!-- END filters: listing cards must be outside this div -->

        <!-- All listing cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">

            <% for (const list of allListings) { %>

                <div class="col">
                    <%# Stored prices are whole rupees until P04-T01 moves them to paise; the card takes paise. %>
                    <%- include("../partials/listing-card.ejs", { item: {
                        id: list._id,
                        title: list.title,
                        imageUrl: list.image && list.image.url,
                        location: list.location,
                        country: list.country,
                        priceMinor: Number.isFinite(list.price) ? list.price * 100 : null,
                        currency: "INR",
                        taxNote: "+18% GST"
                    } }) %>
                </div>

                <% } %>

        </div>

    <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
        // Previous and next category navigation
        const filterContainer = document.getElementById("filter-container");
        const prevButton = document.getElementById("filters-prev");
        const nextButton = document.getElementById("filters-next");

        if (filterContainer && prevButton && nextButton) {
            const scrollAmount = 300;

            prevButton.addEventListener("click", () => {
                filterContainer.scrollBy({
                    left: -scrollAmount,
                    behavior: "smooth"
                });
            });

            nextButton.addEventListener("click", () => {
                filterContainer.scrollBy({
                    left: scrollAmount,
                    behavior: "smooth"
                });
            });

            function updateFilterButtons() {
                const maxScroll = Math.max(
                    0,
                    filterContainer.scrollWidth - filterContainer.clientWidth
                );

                prevButton.disabled = filterContainer.scrollLeft <= 1;
                nextButton.disabled =
                    filterContainer.scrollLeft >= maxScroll - 1;
            }

            filterContainer.addEventListener("scroll", updateFilterButtons);
            window.addEventListener("resize", updateFilterButtons);

            updateFilterButtons();
        }

        // Display tax information based on the toggle state
        const taxSwitch = document.getElementById("switchMdLabel");
        const taxInfo = document.querySelectorAll(".tax-info");

        if (taxSwitch) {
            function updateTaxInfo() {
                taxInfo.forEach((info) => {
                    info.style.display = taxSwitch.checked ? "inline" : "none";
                });
            }

            taxSwitch.addEventListener("change", updateTaxInfo);
            updateTaxInfo();
        }
    </script>