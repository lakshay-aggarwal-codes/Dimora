<% layout("/layouts/boilerPlate") %>
<%#
    Edit a published or unpublished listing, one section at a time. Locals:
    listing, values/errors (by section key), formError, failedKey, lists, gallery,
    maxImages. Each section is its own form (a form cannot sit inside another),
    so saving one never touches the others; the photo manager is the last section.
%>
<%
    const sections = [
        { key: "basics", title: "The basics" },
        { key: "location", title: "Location" },
        { key: "details", title: "Rooms and amenities" },
        { key: "pricing", title: "Price and rules" },
        { key: "photos", title: "Photos" },
    ];
%>
<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h1 class="h3">Edit your Listing</h1>
        <p class="text-muted"><a href="/listings/<%= listing._id %>"><%= listing.title %></a> · <%= listing.status %></p>

        <% if (listing.needsReview) { %>
        <div class="alert alert-warning" role="status">We guessed this listing's address from its old location text. Please check it in the Location section and save it to confirm.</div>
        <% } %>
        <% if (formError) { %>
        <div class="alert alert-danger" role="alert"><%= formError %></div>
        <% } else if (failedKey) { %>
        <div class="alert alert-danger" role="alert">Please fix the highlighted fields in “<%= (sections.find((s) => s.key === failedKey) || {}).title %>”.</div>
        <% } %>

        <nav aria-label="Sections of this listing" class="edit-sections-nav">
            <ul class="list-inline">
                <% sections.forEach((section) => { %>
                <li class="list-inline-item"><a href="#<%= section.key %>"><%= section.title %></a></li>
                <% }) %>
            </ul>
        </nav>

        <% ["basics", "location", "details", "pricing"].forEach((key) => { const meta = sections.find((s) => s.key === key); %>
        <section id="<%= key %>" class="edit-section" aria-labelledby="<%= key %>-heading">
            <h2 id="<%= key %>-heading" class="h4"><%= meta.title %></h2>
            <form method="POST" action="/listings/<%= listing._id %>/sections/<%= key %>?_method=PUT" novalidate>
                <%- include("../includes/csrf.ejs") %>
                <%- include("../host/fields/" + key + ".ejs", { values: values[key], errors: errors[key], lists }) %>
                <button type="submit" class="btn btn-dark">Save <%= meta.title.toLowerCase() %></button>
            </form>
        </section>
        <% }) %>

        <%- include("../partials/photo-manager.ejs", { listing, images: gallery, maxImages }) %>
    </div>
</div>
