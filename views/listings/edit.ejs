<% layout("/layouts/boilerPlate") %>

    <div class="row mt-3">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h1 class="h3">Edit your Listing</h1>

            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT&_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" novalidate class="needs-validation"
                enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input id="title" value="<%= listing.title %>" name="listing[title]" type="text"
                        class="form-control" aria-describedby="title-feedback" required>
                    <div class="invalid-feedback" id="title-feedback">Please enter a title.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea id="description" name="listing[description]" required rows="4"
                        class="form-control" aria-describedby="description-feedback"><%= listing.description %></textarea>
                    <div class="invalid-feedback" id="description-feedback">Please enter a short description.</div>
                </div>

                <% if (originalImageUrl) { %>
                <div class="mb-3">
                    <p class="form-label mb-1">Current listing image</p>
                    <img class="listing-edit-photo" src="<%= originalImageUrl %>" alt="Current photo of this listing">
                </div>
                <% } %>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input id="image" name="listing[image][url]" class="form-control" type="file" accept="image/*">
                </div>

                <div class="row">
                    <div class="mb-3 col-12 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input id="price" value="<%= listing.price ?? '' %>" name="listing[price]" type="number" min="0"
                            inputmode="numeric" class="form-control" aria-describedby="price-feedback" required>
                        <div class="invalid-feedback" id="price-feedback">Please enter a valid price.</div>
                    </div>

                    <div class="mb-3 col-12 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input id="country" value="<%= listing.country ?? '' %>" name="listing[country]" type="text"
                            class="form-control" aria-describedby="country-feedback" required>
                        <div class="invalid-feedback" id="country-feedback">Please enter the country name.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input id="location" value="<%= listing.location ?? '' %>" name="listing[location]" type="text"
                        class="form-control" aria-describedby="location-feedback" required>
                    <div class="invalid-feedback" id="location-feedback">Please enter the location.</div>
                </div>

                <div class="mb-5">
                    <button class="btn btn-dark edit-btn" type="submit">Edit Listing</button>
                </div>
            </form>
        </div>
    </div>
