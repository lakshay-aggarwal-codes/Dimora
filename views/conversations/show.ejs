<% layout("/layouts/boilerPlate") %>
<%#
    One conversation (P11-T02). Locals: conversation, messages, hasMore,
    nextBefore (src/services/conversations.js thread). Message text is plain
    text and always printed escaped; line breaks are kept by CSS, not HTML.
    `live` is true for the newest page: public/js/conversation-thread.js then
    asks for new messages every 15 seconds while the tab is visible.
%>
<div class="row mt-3">
    <div class="col-12 col-lg-8">
        <p class="mb-1"><a href="/messages">&larr; All messages</a></p>
        <p class="mb-1"><a href="/listings/<%= conversation.listingId %>"><%= conversation.listingTitle %></a></p>
        <h1 class="h3">Conversation with <%= conversation.otherName %></h1>
        <% if (conversation.reservationId) { %>
        <p class="text-body-secondary">About <a href="/trips/<%= conversation.reservationId %>">this booking</a>.</p>
        <% } %>

        <% if (hasMore) { %>
        <p><a href="/conversations/<%= conversation.id %>?before=<%= nextBefore %>">Show earlier messages</a></p>
        <% } %>

        <p class="text-body-secondary" data-empty<%- messages.length > 0 ? " hidden" : "" %>>No messages yet. Say hello below.</p>
        <ol class="message-list" role="log" aria-label="Messages, oldest first" data-message-list
            data-other-name="<%= conversation.otherName %>"<% if (live) { %> data-messages-url="/api/conversations/<%= conversation.id %>/messages" data-poll-seconds="15"<% } %>>
            <% messages.forEach((m) => { %>
            <li class="message<%= m.mine ? ' message-mine' : '' %>" data-id="<%= m.id %>">
                <p class="message-meta"><strong><%= m.mine ? "You" : conversation.otherName %></strong> · <time datetime="<%= m.iso %>"><%= m.when %></time></p>
                <p class="message-body"><%= m.body %></p>
            </li>
            <% }) %>
        </ol>

        <% if (conversation.canReply) { %>
        <form action="/conversations/<%= conversation.id %>/messages" method="POST" class="mt-3">
            <%- include("../includes/csrf.ejs") %>
            <label class="form-label" for="message-body">Your message</label>
            <textarea class="form-control" id="message-body" name="body" rows="3" maxlength="1000" required aria-describedby="message-hint"></textarea>
            <div class="form-text" id="message-hint">Plain text, up to 1000 characters.</div>
            <button type="submit" class="btn btn-dark mt-2">Send</button>
        </form>
        <% } else { %>
        <p class="alert alert-secondary mt-3" role="status">You cannot send messages in this conversation right now.</p>
        <% } %>
    </div>
</div>
<script src="/js/conversation-thread.js"></script>
