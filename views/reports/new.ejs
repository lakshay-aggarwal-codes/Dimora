<% layout("/layouts/boilerPlate") %>
<%#
    Report form (P12-T04). Locals: target { kind, id, label, url }, kindLabel,
    reasons, limits, values { reason, details }, error. The reported thing is
    looked up by the server from kind and id on every request; the form only
    carries the pair back.
%>
<div class="row mt-3">
    <div class="col-12 col-md-8 col-lg-6 mx-auto">
        <h1 class="h3 mb-2">Report <%= kindLabel.toLowerCase() %></h1>
        <p class="mb-3">You are reporting: <a href="<%= target.url %>"><%= target.label %></a></p>

        <% if (error) { %>
        <div class="alert alert-danger" role="alert" data-report-error><%= error %></div>
        <% } %>

        <form method="POST" action="/reports" novalidate>
            <%- include("../includes/csrf.ejs") %>
            <input type="hidden" name="kind" value="<%= target.kind %>">
            <input type="hidden" name="id" value="<%= target.id %>">

            <fieldset class="mb-3">
                <legend class="h6">Why are you reporting this?</legend>
                <% reasons.forEach((r, i) => { %>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="reason" id="reason-<%= r.value %>" value="<%= r.value %>"<% if (values.reason === r.value) { %> checked<% } %><% if (i === 0) { %> required<% } %>>
                    <label class="form-check-label" for="reason-<%= r.value %>"><%= r.label %></label>
                </div>
                <% }) %>
            </fieldset>

            <div class="mb-3">
                <label class="form-label" for="report-details">Details (optional, but needed for "Something else")</label>
                <textarea class="form-control" id="report-details" name="details" rows="5" maxlength="<%= limits.detailsMax %>"><%= values.details %></textarea>
                <div class="form-text">Up to <%= limits.detailsMax %> characters. Do not include passwords or payment details.</div>
            </div>

            <button type="submit" class="btn btn-dark">Send report</button>
            <a class="btn btn-link" href="<%= target.url %>">Cancel</a>
        </form>
        <p class="small text-body-secondary mt-3">The person you report is not told who reported them.</p>
    </div>
</div>
